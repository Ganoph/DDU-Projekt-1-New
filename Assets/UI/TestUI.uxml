                <ui:Label text="100" name="HealthAmount" style="position: absolute; top: -7px; left: 18px; color: rgb(255, 255, 255); font-size: 15px; width: 60px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SettingsContainer" class="SettingsVisible SettingsHide" style="flex-grow: 0; top: auto; right: auto; bottom: auto; justify-content: center; align-self: flex-end;">
