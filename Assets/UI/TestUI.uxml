                <ui:Label text="0" name="WaveCount" style="position: absolute; top: 10px; left: 100px; -unity-font-definition: url(&quot;project://database/Assets/UI/Iceland-Regular.ttf?fileID=12800000&amp;guid=37f79c70bf284cc4a8468bd5f5ab57d9&amp;type=3#Iceland-Regular&quot;); font-size: 25px; color: rgb(255, 255, 255); -unity-text-align: upper-center; width: 24px;"/>
