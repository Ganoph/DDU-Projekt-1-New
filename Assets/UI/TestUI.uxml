    <Style src="project://database/Assets/UI/Stylesheet.uss?fileID=7433441132597879392&amp;guid=78edc41a2257e50449bae4c810cb66d0&amp;type=3#Stylesheet"/>
    <ui:VisualElement name="MainHUD" style="flex-grow: 1; justify-content: flex-end; align-items: stretch; align-content: auto;">
        <ui:VisualElement name="TopContainer" style="flex-grow: 1; align-items: center; justify-content: flex-start; align-content: auto; max-height: none; top: auto;">
