:root {
}

.button {
    width: 70px;
    height: 70px;
    -unity-font-style: bold;
    font-size: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    scale: 1 1;
    background-image: url("project://database/Assets/UI/TowerSelection.png?fileID=2800000&guid=546ac1ccb62e1ea4f8e307cea0eeb5cd&type=3#TowerSelection");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    left: auto;
    transition-duration: 0.4s;
    flex-shrink: 1;
    flex-grow: 0;
    align-content: auto;
    justify-content: center;
    align-items: stretch;
    align-self: auto;
    flex-wrap: nowrap;
    flex-direction: column;
}



.SettingsVisible {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: flex-end;
    align-self: flex-end;
    align-content: auto;
    flex-direction: column;
    flex-wrap: nowrap;
    position: relative;
    top: 50px;
    bottom: 20px;
    left: auto;
    right: 10px;
    height: 380px;
    width: 300px;
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: center;
    transition-duration: 0.3s;
    -unity-font-style: bold;
}

.SettingsHide {
    translate: 323px 0;
    transition-duration: 0.3s;
}

.upgradeButton {
    position: absolute;
    top: 126px;
    left: 124px;
    width: 150px;
    height: 74px;
    font-size: 18px;
    background-image: url("project://database/Assets/UI/UI%20Button%201.png?fileID=2800000&guid=39e635cc4a4af6a45842be443ccfe397&type=3#UI Button 1");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.upgradeButtonInv {
    color: rgb(255, 0, 0);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=c55d021fe12181e4eb21038ddea5b219&type=3#NotInter-Regular");
    -unity-font-style: bold;
    -unity-background-image-tint-color: rgb(255, 0, 0);
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}


